# Copy to .env and fill in. Never commit .env.

# Personal API key from Garmin Connect Web > Settings > Personal API Key
GARMIN_API_KEY=

# "http" for the hosted server, "stdio" for Claude Desktop / Claude Code locally
MCP_TRANSPORT=http
LISTEN_ADDR=127.0.0.1:8080

# Set at least one of these in http mode. Min 32 characters.
# Generate with: openssl rand -hex 32
# Bearer token: for clients that can send headers (Claude Code, MCP Inspector)
MCP_BEARER_TOKEN=
# URL secret: for clients that can't (claude.ai / Claude mobile custom connectors).
# The endpoint becomes https://your-domain/mcp/<MCP_URL_SECRET>
MCP_URL_SECRET=
